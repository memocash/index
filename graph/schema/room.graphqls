type Room {
    name: String!
    posts(start: Date, tx: Hash, limit: Uint32, newest: Boolean = true): [Post!]
    followers(start: Int): [RoomFollow!]
}

type RoomFollow {
    name: String!
    room: Room!
    lock: Lock!
    address: Address!
    unfollow: Boolean!
    tx_hash: Hash!
    tx: Tx!
}
