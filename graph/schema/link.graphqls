type LinkRequest {
    tx: Tx!
    tx_hash: Hash!
    lock: Lock!
    address: Address!
    parent_lock: Lock!
    parent_address: Address!
    message: String!
    accepts: [LinkAccept]
}

type LinkAccept {
    tx: Tx!
    tx_hash: Hash!
    request_tx_hash: Hash!
    message: String!
    request: LinkRequest
    revokes: [LinkRevoke]
}

type LinkRevoke {
    tx: Tx!
    tx_hash: Hash!
    accept_tx_hash: Hash!
    message: String!
    accept: LinkAccept
}
